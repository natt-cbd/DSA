#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>

#define MAX 10

// Node structure for linked list bucket
typedef struct node {
    char elem;
    struct node *next;
} Node, *NodePtr;

typedef NodePtr OpenDict[MAX]; // ARRAY NA SYA OPKAAUA DONT BE LIBOGED

int HASH(char key) {
    return (toupper(key) - 'A') % MAX; //to get the index of where the actual value should be stored
}

void displayDict(OpenDict D) {
    printf("\n--- OPEN HASH DICTIONARY (Chaining) ---\n");
    for (int i = 0; i < MAX; i++) {
        printf("[%d]: ", i);
        NodePtr trav = D[i];
        while (trav != NULL) {
            printf("%c -> ", trav->elem);
            trav = trav->next;
        }
        printf("NULL\n");
    }
}

// TODO EXERCISES FOR STUDENTS:

void initDict(OpenDict D) {
    // TODO: Loop through array D and set every bucket pointer to NULL
    for(int i = 0; i < MAX; ++i){
        D[i]  = NULL;
    }
}

void insertDict(OpenDict D, char elem) {
    // TODO: Hash elem, malloc a new node, and insert at head of list at D[HASH(elem)]
    int index = HASH(elem);
    NodePtr *trav;
    
    NodePtr newNode = malloc(sizeof(Node));
    if(newNode == NULL) return;
    newNode->elem = elem;
    
    for(trav = &(D[index]); *trav && newNode->elem >= (*trav)->elem; trav = &(*trav)->next){ //STUDY POINTERS N ADRRESS OF BALIKK !!!
            if(newNode->elem == (*trav)->elem){
                free(newNode);
                return;
            }
        } 
    newNode->next = *trav;
    *trav = newNode;
}

void deleteDict(OpenDict D, char elem) {
    // TODO: Search linked list at D[HASH(elem)], unlink target node, and free memory
    int index = HASH(elem);
    NodePtr *trav = &(D[index]);
    
    for(; *trav && (*trav)->elem != elem; trav = &(*trav)->next){} //insert sorted

    if (*trav != NULL) {     // Guard against crash if element is not in the set
        NodePtr temp = *trav;
        *trav = temp->next;     // Unlink target node
        free(temp);             // Free memory
    }
}

int main() {
    OpenDict D;
    initDict(D);

    printf("Inserting 'A', 'K', 'U' (All hash to index 0)...\n");
    insertDict(D, 'A');
    insertDict(D, 'K');
    insertDict(D, 'U');
    insertDict(D, 'A');
    insertDict(D, 'N');
    displayDict(D);

    printf("Deleting 'K'...\n");
    deleteDict(D, 'K');
    deleteDict(D, 'N');
    displayDict(D);

    return 0;
}
