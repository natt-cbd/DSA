#include <stdio.h>
#include <ctype.h>

#define MAX 5
#define EMPTY '?'
#define DELETED '!'

typedef char LinearDict[MAX];

int HASH(char key) {
    return (toupper(key) - 'A') % MAX;
}

void displayDict(LinearDict D) {
    printf("\n--- CLOSED HASH DICTIONARY (Linear Probing) ---\n");
    printf("%5s | %-5s\n", "IDX", "DATA");
    printf("%5s | %5s\n", "----", "----");
    for (int i = 0; i < MAX; i++) {
        printf(" %5d  |  %-5c\n", i, D[i]);
    }
}

// TODO EXERCISES FOR STUDENTS:

void initDict(LinearDict D) {
    // TODO: Loop through array and initialize all slots to EMPTY ('?')
    for(int i  = 0; i < MAX; ++i){
        D[i] = EMPTY;
    }
}

void insertDict(LinearDict D, char elem) { //if array, picture CIRCULAR implementation
    // TODO: Use probing formula (HASH(elem) + i) % MAX to find first EMPTY or DELETED slot
    
    for(int i = 0; i < MAX; ++i){
        int index = (HASH(elem) + i) % MAX;
        if(D[index] == elem){
            break;
        }
        
        if(D[index] == EMPTY || D[index] == DELETED){
            D[index] = elem;
            break;
        }
    }
}

void deleteDict(LinearDict D, char elem) {
    // TODO: Search sequentially starting at HASH(elem) until element is found or EMPTY hit
    // Mark target slot as DELETED ('!')
    for(int index = HASH(elem); index < MAX; ++index){
        if(D[index] == elem){
            D[index] = DELETED;
        }
    }
}

int main() {
    LinearDict D;
    initDict(D);

    printf("Inserting 'A', 'K', 'U' (All hash to index 0)...\n");
    insertDict(D, 'A');
    insertDict(D, 'K');
    insertDict(D, 'U');
    insertDict(D, 'A');
    insertDict(D, 'N');
    insertDict(D, 'M');
    displayDict(D);

    printf("Deleting 'K'...\n");
    deleteDict(D, 'K');
    displayDict(D);
    
    insertDict(D, 'Y');
    displayDict(D);

    return 0;
}
