#include <stdio.h>
#include <ctype.h>

#define MAX 10
#define EMPTY '?'
#define DELETED '!'

typedef struct {
    char data;
    int next;
} VirtualNode;

typedef struct {
    VirtualNode table[MAX]; // Prime Area: indices 0..5, Synonym Area: indices 6..9
    int avail;             // Points to head of free synonym list
} CursorDict;

int HASH(char key) {
    return (toupper(key) - 'A') % 6; // Hash directly into prime area (0..5)
}

void displayDict(CursorDict D) {
    printf("\n--- CLOSED HASH DICTIONARY (Cursor-Based / Synonym Area) ---\n");
    printf("Avail Head Index: %d\n", D.avail);
    printf("%5s | %-5s | %5s\n", "IDX", "DATA", "NEXT");
    printf("%5s - %5s - %5s\n", "----", "----", "----");
    for (int i = 0; i < MAX; i++) {
        printf(" %5d  |  %-5c  |  %5d\n", i, D.table[i].data, D.table[i].next);
    }
}

// TODO EXERCISES FOR STUDENTS:

void initDict(CursorDict *D) {
    // TODO: 
    // 1. Prime area (0..5): data = EMPTY, next = -1
    // 2. Synonym area (6..9): link next pointers sequentially to form free list (very last node on free/avail list should be -1)
    // 3. Set D->avail = 6
    
    D->avail = 6;
    
    for(int i = 0; i <= 5; ++i){
        D->table[i].data = EMPTY;
        D->table[i].next = -1;
    }
    
    for(int i = 6; i <= MAX - 1; ++i){
        D->table[i].data = EMPTY;
        
        if(i == MAX - 1){
            D->table[i].next = -1;
        } else {
            D->table[i].next = i + 1;
        }
    }
}

void insertDict(CursorDict *D, char elem) {
    // TODO: 
    // 1. Compute H = HASH(elem)
    // 2. If table[H] is EMPTY or DELETED, store elem directly at H 
    // 3. check for duplicates (both in prime AND synonym list) !!
    // 4. Else, pull index from D->avail, store elem, and append to table[H].next chain
    
    int index = HASH(elem);
    
    if(D->table[index].data == EMPTY || D->table[index].data == DELETED){
        D->table[index].data = elem;
        return;
    }
    
    if(D->table[index].data == elem) return; //this one checks if the slot that was NOT empty or deleted already 
                                            //has the elem u want to insert (bale duplicate na sha ganon)
    
    int *trav = &(D->table[index].next); //traverses thru the synonym list to check for duplicate
    while(*trav != -1){
        if(D->table[*trav].data == elem) return; 
        trav = &(D->table[*trav].next);
    }
    
    //so if the PRIME SLOT is OCCUPIED and it is NOT a DUPLICATE
    if(D->avail != -1){ //if synonym list is not full
        int newIndex = D->avail;
        D->avail = D->table[newIndex].next;
        
        D->table[newIndex].data = elem;
        D->table[newIndex].next = -1;
        *trav = newIndex; //link into the synonym chain
    }
}

void deleteDict(CursorDict *D, char elem) {
    // TODO: Search key in prime slot or linked synonym chain. Unlink node and recycle index to avail.
    // 1. check if key is in prime slot
    // 2. set as DELETED directly if the next is -1 (no synonyms attached); else promote the first synonym node into the prime slot -- put the vacated synonym node balik sa avail list
    // 3. if the key is NOT in prime slot (in synonym list) -- butterfly func to find elem
    // 4. recheck if trav (from butterfly func) is not -1 -- unlink THEN put the unlinked node balik sa avail list
   
   int index = HASH(elem);
   
   if(D->table[index].data == elem){
       if(D->table[index].next == -1){ //if it has NO SYNONYMS attached
           D->table[index].data = DELETED; 
       } else {
           int synoIndex = D->table[index].next;
           
           D->table[index].data = D->table[synoIndex].data;
           D->table[index].next = D->table[synoIndex].next;
           
           D->table[synoIndex].data = EMPTY;
           D->table[synoIndex].next = D->avail;
           D->avail = synoIndex;
       }
       
       return; //DONT FORGET !!! para di na sya mag go down pa
   }
   
   int *trav = &(D->table[index].next);
   for(; *trav != -1 && D->table[*trav].data != elem; trav = &(D->table[*trav].next)){}
   
   if(*trav != -1){
       int temp = *trav;
       *trav = D->table[temp].next;
       
       D->table[temp].data = EMPTY;
       D->table[temp].next = D->avail;
       D->avail = temp;
   }
}

int main() {
    CursorDict D;
    initDict(&D);

    printf("Inserting 'A', 'G', 'M' (All hash to Prime Index 0)...\n");
    insertDict(&D, 'A');
    insertDict(&D, 'G');
    insertDict(&D, 'M');
    displayDict(D);

    printf("Deleting 'G'...\n");
    deleteDict(&D, 'G');
    displayDict(D);

    return 0;
}
