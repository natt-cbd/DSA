#include <stdio.h>
#include <ctype.h>

#define MAX 10
#define EMPTY '?'
#define DELETED '!'

typedef struct {
    char data;
    int next;
} VirtualNode;

typedef struct {
    VirtualNode table[MAX]; // Prime Area: indices 0..5, Synonym Area: indices 6..9
    int avail;             // Points to head of free synonym list
} CursorDict;

int HASH(char key) {
    return (toupper(key) - 'A') % 6; // Hash directly into prime area (0..5)
}

void displayDict(CursorDict D) {
    printf("\n--- CLOSED HASH DICTIONARY (Cursor-Based / Synonym Area) ---\n");
    printf("Avail Head Index: %d\n", D.avail);
    printf("%5s | %-5s | %5s\n", "IDX", "DATA", "NEXT");
    printf("%5s - %5s - %5s\n", "----", "----", "----");
    for (int i = 0; i < MAX; i++) {
        printf(" %5d  |  %-5c  |  %5d\n", i, D.table[i].data, D.table[i].next);
    }
}

// TODO EXERCISES FOR STUDENTS:

void initDict(CursorDict *D) {
    // TODO: 
    // 1. Prime area (0..5): data = EMPTY, next = -1
    // 2. Synonym area (6..9): link next pointers sequentially to form free list
    // 3. Set D->avail = 6
    
    D->avail = 6;
    
    for(int i = 0; i <= 5; ++i){
        D->table[i].data = EMPTY;
        D->table[i].next = -1;
    }
    
    for (int i = 6; i < MAX - 1; ++i) {
        D->table[i].data = EMPTY;
        D->table[i].next = i + 1;
    }
    D->table[MAX - 1].data = EMPTY;
    D->table[MAX - 1].next = -1; // End of avail list
}

void insertDict(CursorDict *D, char elem) {
    // TODO: 
    // 1. Compute H = HASH(elem)
    // 2. If table[H] is EMPTY or DELETED, store elem directly at H --- check for duplicates !!
    // 3. Else, pull index from D->avail, store elem, and append to table[H].next chain
    
    int index = HASH(elem);
    
    // If prime slot is empty/deleted, store directly in prime area
    if (D->table[index].data == EMPTY || D->table[index].data == DELETED) {
        D->table[index].data = elem;
        return;
    }
    
    // Traverse chain to check for duplicates
    int *trav = &(D->table[index].next);
    if (D->table[index].data == elem) return; // Duplicate in prime slot
    
    while (*trav != -1) {
        if (D->table[*trav].data == elem) return; // Duplicate in synonym list
        trav = &(D->table[*trav].next);
    }
    
    // If synonym area has space, allocate from avail
    if (D->avail != -1) {
        int newNode = D->avail;
        D->avail = D->table[newNode].next; // Advance avail head
        
        D->table[newNode].data = elem;
        D->table[newNode].next = -1;
        *trav = newNode; // Link into the synonym chain
    }
}

void deleteDict(CursorDict *D, char elem) {
    // TODO: Search key in prime slot or linked synonym chain. Unlink node and recycle index to avail.
    
    int index = HASH(elem);
    
    // Check if key is in the prime slot
    if (D->table[index].data == elem) {
        if (D->table[index].next == -1) {
            // No synonyms attached
            D->table[index].data = DELETED;
        } else {
            // Promote the first synonym node into the prime slot
            int synonymIdx = D->table[index].next;
            D->table[index].data = D->table[synonymIdx].data;
            D->table[index].next = D->table[synonymIdx].next;
            
            // Recycle the vacated synonym node back to avail
            D->table[synonymIdx].data = EMPTY;
            D->table[synonymIdx].next = D->avail;
            D->avail = synonymIdx;
        }
        return;
    }
    
    // Traversal for target in synonym chain
    int *trav = &(D->table[index].next);
    while (*trav != -1 && D->table[*trav].data != elem) {
        trav = &(D->table[*trav].next);
    }
    
    if (*trav != -1) { // Found in synonym list
        int temp = *trav;
        *trav = D->table[temp].next; // Unlink target node
        
        // Recycle unlinked node back to avail list
        D->table[temp].data = EMPTY;
        D->table[temp].next = D->avail;
        D->avail = temp;
    }
}

int main() {
    CursorDict D;
    initDict(&D);

    printf("Inserting 'A', 'G', 'M' (All hash to Prime Index 0)...\n");
    insertDict(&D, 'A');
    insertDict(&D, 'G');
    insertDict(&D, 'M');
    displayDict(D);

    printf("Deleting 'G'...\n");
    deleteDict(&D, 'G');
    displayDict(D);

    return 0;
}
