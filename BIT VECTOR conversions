// 1. CONVERT: Word Array (short int[]) -> Bit Vector (int[])
int *wordToBitVector(short int codes[], int size)
{
    int *result = malloc(sizeof(int) * (size * 16));
    if (result == NULL) return NULL;
    
    int ctr = 0;
    for (int j = 0; j < size; j++) {
        for (int i = 15; i >= 0; --i) {
            result[ctr++] = (codes[j] >> i) & 1;
        }
    }
    return result;
}

// 2. CONVERT: Bit Vector (int[]) -> ASCII Message (char[])
char *bitVectorToAscii(int bits[], int totalBits)
{
    int numChars = totalBits / 8;
    char *string = malloc(sizeof(char) * (numChars + 1));
    if (string == NULL) return NULL;
    
    string[numChars] = '\0';
    for(int i = 0; i < numChars; ++i){
        string[i] = 0; // Initialize byte
    }
    
    for (int i = 0; i < totalBits; ++i) {
        int index = i / 8;
        string[index] = (string[index] << 1) | bits[i];
    }
    
    return string;
}

// 3. CONVERT: ASCII String (char[]) -> Bit Vector (int[])
// TODO for practice: Take an 8-character string, pull out each bit from left-to-right (MSB to LSB), and store into a 64-bit array!
int *asciiToBitVector(char *str)
{
    int *result = malloc(sizeof(int) * 64);
    if (result == NULL) return NULL;
    
    int ctr = 0;
    for (int c = 0; c < 8; c++) {
        // Hint: Similar to codes, shift each character down from 7 to 0 and extract via & 1
        for (int i = 7; i >= 0; --i) {
            result[ctr++] = (str[c] >> i) & 1;
        }
    }
    
    return result;
}

// 4. CONVERT: Bit Vector (int[]) -> Word Array (short int[])
// TODO for practice: Group the 64 bits into blocks of 16, and use shift-and-accumulate to rebuild each short int!
short int *bitVectorToWord(int bits[], int totalWords)
{
    short int *result = malloc(sizeof(short int) * totalWords);
    if (result == NULL) return NULL;
    
    for (int w = 0; w < totalWords; w++) {
        short int word = 0;
        for (int i = 0; i < 16; i++) {
            int bitIndex = (w * 16) + i;
            word = (word << 1) | bits[bitIndex];
        }
        result[w] = word;
    }
    
    return result;
}
