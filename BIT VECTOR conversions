#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// --- FUNCTION PROTOTYPES FOR YOU TO PRACTICE ---
int *wordToBitVector(short int codes[], int size);
char *bitVectorToAscii(int bits[], int totalBits);
int *asciiToBitVector(char *str);
short int *bitVectorToWord(int bits[], int totalWords);

// --- HELPER DISPLAY FUNCTIONS ---
void displayBitPattern(int bits[], int totalBits);

int main(void)
{
    // Test case: 4 short ints representing an 8-letter item
    short int codes[4] = {20047, 21573, 16975, 20299};
    int choice;

    do {
        printf("\n=========================================\n");
        printf("    BIT MANIPULATION & CONVERSION LAB    \n");
        printf("=========================================\n");
        printf("Current Working Words: %d %d %d %d\n\n", codes[0], codes[1], codes[2], codes[3]);
        printf("[1] Word -> Bit Vector -> ASCII Message\n");
        printf("[2] ASCII String -> Bit Vector -> Word Array\n");
        printf("[3] Word -> ASCII (Direct Conversion)\n");
        printf("[4] Exit\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input.\n");
            break;
        }

        if (choice == 1) {
            // Path: Word -> Bit Vector -> ASCII
            int *bits = wordToBitVector(codes, 4);
            printf("\n--- Step 1: Bit Vector (64 bits) ---\n");
            displayBitPattern(bits, 64);
            
            char *msg = bitVectorToAscii(bits, 64);
            printf("\n--- Step 2: Recovered ASCII Message ---\n");
            printf("%s\n", msg);

            free(bits);
            free(msg);

        } else if (choice == 2) {
            // Path: ASCII -> Bit Vector -> Word Array
            char inputStr[9];
            printf("\nEnter an 8-letter word to encode: ");
            scanf("%s", inputStr);

            int *bits = asciiToBitVector(inputStr);
            printf("\n--- Step 1: Bit Vector (64 bits) ---\n");
            displayBitPattern(bits, 64);

            short int *newWords = bitVectorToWord(bits, 4);
            printf("\n--- Step 2: Converted Word Array ---\n");
            printf("{%d, %d, %d, %d}\n", newWords[0], newWords[1], newWords[2], newWords[3]);

            free(bits);
            free(newWords);

        } else if (choice == 3) {
            // Path: Word -> ASCII (Direct/Combined shortcut)
            int *bits = wordToBitVector(codes, 4);
            char *msg = bitVectorToAscii(bits, 64);
            printf("\nDirect Word-to-ASCII Message: %s\n", msg);
            free(bits);
            free(msg);
        }

    } while (choice != 4);

    printf("\nExiting lab. Keep practicing! Good luck!\n");
    return 0;
}

// --- HELPER UTILITY ---
void displayBitPattern(int bits[], int totalBits)
{
    for (int i = 0; i < totalBits; i++) {
        printf("%d", bits[i]);
        if ((i + 1) % 16 == 0 && i != totalBits - 1) {
            printf(" "); // Space out every 16 bits for readability
        }
    }
    printf("\n");
}


