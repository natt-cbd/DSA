bool addElement(Set s, int item){
    if(s[item] == 1){
        return 0;
    } else {
        s[item] = 1;
        return 1;
    }
}

bool removeElement(Set s, int item){
    if(s[item] == 0){
        return 0;
    } else {
        s[item] = 0;
        return 1;
    }
}
