#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

#define MAX 10

typedef bool Set[MAX]; // set represented as array of booleans

// Core Set Operations
void initSet(Set s);
bool addElement(Set s, int item); // dili pointer ang s, bcs its already an array == set[] == *s
bool removeElement(Set s, int item);
bool isMember(Set s, int item);
void display(Set s);

void display(Set s);

// Set Algebra Operations
void setUnion(Set a, Set b, Set result); // Pass-by-pointer array output; if you want to return an array (like not void), you use bool pointer
bool *setIntersection(Set a, Set b);     // Dynamic memory allocation return ; to return an array, will not work without malloc -- BOOL ARRAY
bool *setDifference(Set a, Set b);       // Dynamic memory allocation return


//--------------------------------------------------------------------------------

void initSet(Set s){        //set every index of the static array as FALSE / 0 first
    for(int i = 0; i < MAX; ++i){
        s[i] = false;
    }
}

// Adds element to set; returns true if added, false if out of bounds or already present
bool addElement(Set s, int item) {
    if (item < 0 || item >= MAX) return false; // Bounds guard
    if (s[item]) return false;                 // Already present
    
    s[item] = true;
    return true;
}

// Removes element from set; returns true if removed, false if not present or out of bounds
bool removeElement(Set s, int item) {
    if (item < 0 || item >= MAX) return false; // Bounds guard
    if (!s[item]) return false;                // NOT present
    
    s[item] = false;
    return true;
}

// Checks set membership
bool isMember(Set s, int item) {
    if (item < 0 || item >= MAX) return false;
    return s[item];
}

// Displays set in traditional mathematical set notation { x1, x2, ... }
void display(Set s) {
    printf("{ ");
    bool first = true;
    for (int i = 0; i < MAX; i++) {
        if (s[i]) {
            if (!first) printf(", ");
            printf("%d", i);
            first = false;
        }
    }
    printf(" }\n");
}

// Union: result = A U B
void setUnion(Set a, Set b, Set result) {
    for (int i = 0; i < MAX; i++) {
        result[i] = a[i] || b[i];
    }
}

// Intersection: returns heap-allocated pointer for A n B
bool *setIntersection(Set a, Set b) {
    bool *result = (bool *)malloc(sizeof(bool) * MAX);
    if (result == NULL) return NULL; // Memory allocation check

    for (int i = 0; i < MAX; i++) {
        result[i] = a[i] && b[i];
    }
    return result;
}

// Difference: returns heap-allocated pointer for A - B
bool *setDifference(Set a, Set b) {
    bool *result = (bool *)malloc(sizeof(bool) * MAX);
    if (result == NULL) return NULL;

    for (int i = 0; i < MAX; i++) {
        result[i] = a[i] && !b[i];
    }
    return result;
}

// Merges Set A and Set B into a new heap-allocated array
bool *mergeSetNew(Set a, Set b) {
    bool *result = (bool *)malloc(sizeof(bool) * MAX);
    if (result == NULL) return NULL; // Memory allocation check

    for (int i = 0; i < MAX; i++) {
        result[i] = a[i] || b[i];
    }
    return result;
}

//--------------------------------------------------------------------------------

int main(){
    Set A, B, C;
    
    // Always initialize sets to false/0 
    initSet(A);
    initSet(B);
    initSet(C);

    // Populate Set A = {1, 3, 7}
    addElement(A, 1);
    addElement(A, 3);
    addElement(A, 7);

    // Populate Set B = {3, 4, 7, 9}
    addElement(B, 3);
    addElement(B, 4);
    addElement(B, 7);
    addElement(B, 9);

    printf("Set A: ");
    display(A);

    printf("Set B: ");
    display(B);

    // Demonstration of removeElement
    removeElement(A, 1);
    printf("Set A after removing 1: ");
    display(A);
    addElement(A, 1); // Re-add for algebra operations

    // 1. Union (Modifies output array directly)
    setUnion(A, B, C);
    printf("Union (A U B): ");
    display(C);

    // 2. Intersection (Returns dynamically allocated array)
    bool *intersectionResult = setIntersection(A, B);
    printf("Intersection (A n B): ");
    display(intersectionResult);
    free(intersectionResult); // Free heap memory

    // 3. Difference (Returns dynamically allocated array)
    bool *differenceResult = setDifference(A, B);
    printf("Difference (A - B): ");
    display(differenceResult);
    free(differenceResult); // Free heap memory
    
    bool *mergee = mergeSetNew(A, B);
    printf("Set A Merge with B: ");
    display(mergee);
    free(mergee); // Free heap memory

    return 0;
}
